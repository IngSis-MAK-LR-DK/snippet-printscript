# Copiar a .env (no se commitea) y ajustar si hace falta.

# Puerto publicado en tu maquina
SERVICE_PORT=8083

# Credenciales de GitHub para bajar el plugin de ci-kit y la libreria PrintScript al construir
# la imagen (son las mismas gpr.user y gpr.key de ~/.gradle/gradle.properties).
# NO commitear el .env.
GPR_USER=
GPR_KEY=

# Auth0 (ver README de la catedra: austral-ingsis/auth0-integration)
# El servicio tambien lee este archivo al correr con ./gradlew bootRun (spring.config.import).
# AUTH0_DOMAIN: dominio del tenant, SIN https:// (ej. dev-xxxx.us.auth0.com)
# AUTH0_AUDIENCE: el "Identifier" de la API que creaste en Auth0 (el "aud" del token). Es UNO SOLO
#   para toda la plataforma: todos los servicios validan la misma.
AUTH0_DOMAIN=TU-TENANT.us.auth0.com
AUTH0_AUDIENCE=https://snippet-searcher
